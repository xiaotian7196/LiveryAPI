#!/bin/sh
set -e

if ! getent group liveryapi >/dev/null; then
    addgroup --system liveryapi
fi
if ! getent passwd liveryapi >/dev/null; then
    adduser --system --ingroup liveryapi --no-create-home --home /var/lib/liveryapi liveryapi
fi

install -d -o liveryapi -g liveryapi -m 0750 /var/lib/liveryapi
systemctl daemon-reload || true
systemctl enable liveryapi.service || true
systemctl restart liveryapi.service || true

exit 0
